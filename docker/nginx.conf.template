server {
    listen ${PORT};
    listen [::]:${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/plain text/css application/json application/javascript image/svg+xml;
    gzip_min_length 1024;

    # Fichiers à ne jamais mettre en cache (changent sans changer de nom)
    location = /index.html {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
    }

    location = /assets/config.json {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
    }

    # Fichiers buildés avec un hash dans le nom : cache long
    location ~* \.(?:js|css|woff2?|ttf|eot|ico|png|jpg|jpeg|gif|svg|webp)$ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # Routing SPA : toute route inconnue renvoie index.html (ex. /login, /register)
    location / {
        try_files $uri $uri/ /index.html;
    }
}
